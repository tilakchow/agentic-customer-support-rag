{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/chat",
      "destination": "/api/chat"
    },
    {
      "source": "/api/chat/stream",
      "destination": "/api/chat-stream"
    },
    {
      "source": "/api/:path*",
      "destination": "https://agentic-customer-support-rag.onrender.com/:path*"
    }
  ]
}
