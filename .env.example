# =====================================================================
# Agentic Customer Support RAG - Environment Configuration
# =====================================================================

# --- External Provider API Keys ---
# Required for running live LLM generation and search capabilities
GROQ_API_KEY=
PINECONE_API_KEY=
TAVILY_API_KEY=

# --- Security & API Authentication ---
# Secret token for authenticating client requests via X-API-Key header.
# If left empty/unset, the API is public (no authentication required).
API_KEY=

# Environment mode ('development' or 'production'). In production, API_KEY is strictly required.
ENVIRONMENT=development

# When set to true, FastAPI will refuse to start if API_KEY is empty or unset.
REQUIRE_API_KEY=false

# Comma-separated list of allowed origins for Cross-Origin Resource Sharing (CORS)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000,https://agentic-customer-support-rag.vercel.app

# Comma-separated list of trusted reverse proxy IPs for spoof-safe client IP resolution in rate limiting
TRUSTED_PROXIES=

# SlowAPI rate limit for conversational /chat endpoints
RATE_LIMIT=20/minute

# Maximum allowed character length for incoming user messages
MAX_MESSAGE_LENGTH=1500

# Proxy forwarded IP allow-list for Uvicorn (used behind reverse proxies / Docker)
FORWARDED_ALLOW_IPS=*

# --- Knowledge Base & Vector Store Settings ---
INDEX_NAME=industry-agentic-rag-kb
NAMESPACE=bitext-support
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
RETRIEVER_K=4
FASTEMBED_CACHE_PATH=
DATASET_NAME=bitext/Bitext-customer-support-llm-chatbot-training-dataset

# Sample size and random seed for ingestion of the Bitext support dataset
KB_SAMPLE_SIZE=500
KB_SEED=42

# --- LLM & Agent Execution Settings ---
GROQ_MODEL=openai/gpt-oss-20b
GRADER_MODEL=openai/gpt-oss-20b
LLM_TIMEOUT=30.0
LLM_MAX_RETRIES=2
TAVILY_TIMEOUT=15.0
TAVILY_MAX_CONCURRENCY=5

# Maximum number of query rewrite retries before routing to insufficient notice
MAX_RETRIES=1

# Maximum conversation turns to pass as history context to LLM
MAX_THREAD_HISTORY=10

# Maximum conversation messages retained in persistent checkpointer state (bounded memory)
MAX_THREAD_MESSAGES=40

# Allow agent to fall back to Tavily web search for general questions
WEB_FALLBACK_ENABLED=true

# Similarity threshold (e.g. 0.85) to skip LLM evidence grader; unset means disabled
SKIP_GRADER_SCORE=

# SQLite database file path for session checkpointer persistence; unset requires ALLOW_IN_MEMORY_CHECKPOINTS=true in production
CHECKPOINT_DB=

# Explicit opt-in flag to permit ephemeral MemorySaver checkpointer in production (default: false in prod, true in dev)
ALLOW_IN_MEMORY_CHECKPOINTS=false

# Server port (default 8000 locally, 7860 in Docker)
PORT=8000

# --- Frontend & Deployment Proxy Settings ---
# Base API URL used by frontend client (default: /api to route through reverse-proxy / edge functions)
VITE_API_URL=/api

# Client-side API key header injection for direct browser-to-backend communication
VITE_API_KEY=

# Backend target URL used by Vercel edge functions and Vite development proxy
BACKEND_URL=http://localhost:8000
